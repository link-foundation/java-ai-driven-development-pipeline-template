og4j2\",\n                    \"purl\": \"pkg:maven/org.ops4j.pax.logging/pax-logging-log4j2\"\n                  },\n                  \"ranges\": [\n                    {\n                      \"events\": [\n                        {\n                          \"introduced\": \"2.0.0\"\n                        },\n                        {\n                          \"fixed\": \"2.0.13\"\n                        }\n                      ],\n                      \"type\": \"ECOSYSTEM\"\n                    }\n                  ],\n                  \"versions\": [\n                    \"2.0.0\",\n                    \"2.0.1\",\n                    \"2.0.10\",\n                    \"2.0.11\",\n                    \"2.0.12\",\n                    \"2.0.2\",\n                    \"2.0.3\",\n                    \"2.0.4\",\n                    \"2.0.5\",\n                    \"2.0.6\",\n                    \"2.0.7\",\n                    \"2.0.8\",\n                    \"2.0.9\"\n                  ]\n                }\n              ],\n              \"aliases\": [\n                \"CVE-2021-45105\"\n              ],\n              \"database_specific\": {\n                \"cwe_ids\": [\n                  \"CWE-20\",\n                  \"CWE-674\"\n                ],\n                \"github_reviewed\": true,\n                \"github_reviewed_at\": \"2021-12-18T17:59:37Z\",\n                \"nvd_published_at\": \"2021-12-18T12:15:00Z\",\n                \"severity\": \"HIGH\"\n              },\n              \"details\": \"Apache Log4j2 versions 2.0-alpha1 through 2.16.0 (excluding 2.12.3) did not protect from uncontrolled recursion from self-referential lookups. This allows an attacker with control over Thread Context Map data to cause a denial of service when a crafted string is interpreted. This issue was fixed in Log4j 2.17.0 and 2.12.3.\\n\\n\\n# Affected packages\\nOnly the `org.apache.logging.log4j:log4j-core` package is directly affected by this vulnerabi