+++ b/experiments/file-size.test.mjs
@@ -0,0 +1,57 @@
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import test from 'node:test';
+
+const script = resolve(import.meta.dirname, '../scripts/check-file-size.mjs');
+function fixture(t) {
+  const directory = mkdtempSync(join(tmpdir(), 'file-size-'));
+  t.after(() => rmSync(directory, { recursive: true, force: true }));
+  return directory;
+}
+function run(directory, args = []) {
+  return spawnSync(process.execPath, [script, ...args], {
+    cwd: directory, encoding: 'utf8', timeout: 10000,
+  });
+}
+
+for (const extension of ['java', 'mjs', 'js']) {
+  for (const lines of [899, 900, 999, 1000, 1001]) {
+    test(`${extension}: ${lines} lines respects warning and failure boundaries`, t => {
+      const directory = fixture(t);
+      mkdirSync(join(directory, 'nested'));
+      writeFileSync(join(directory, 'nested', `source.${extension}`), '// line\n'.repeat(lines));
+      const result = run(directory);
+      assert.equal(result.status, lines > 1000 ? 1 : 0, result.stdout + result.stderr);
+      if (lines >= 900 && lines <= 1000) {
+        assert.match(result.stdout, /::warning title=File size warning::.*source\./);
+        assert.match(result.stdout, new RegExp(`${lines} lines`));
+      } else {
+        assert.doesNotMatch(result.stdout, /::warning/);
+      }
+    });
+  }
+}
+
+test('ignores generated directories and unrelated files, and preserves custom limits', t => {
+  const directory = fixture(t);
+  for (const excluded of ['target', 'node_modules', '.git', '.idea', 'build']) {
+    mkdirSync(join(directory, excluded));
+    writeFileSync(join(directory, excluded, 'large.mjs'), '// line\n'.repeat(1001));
+  }
+  writeFileSync(join(directory, 'notes.md'), 'line\n'.repeat(1001));
+  writeFileSync(join(directory, 'small.js'), '// line\n'.repeat(11));
+  assert.equal(run(directory).status, 0);
+  assert.equal(run(directory, ['--max-lines', '10']).status, 1);
+});
+
+test('counts an unterminated last line and escapes contributor filenames in annotations', t => {
+  const directory = fixture(t);
+  writeFileSync(join(directory, 'source%\n::error::injected.js'), '// line\n'.repeat(899) + '// last');
+  const result = run(directory);
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(result.stdout, /::warning title=File size warning::.*source%25%0A::error::injected.js.*900 lines/);
+  assert.doesNotMatch(result.stdout, /^::error::injected/m);
+});
diff --git a/experiments/osv-download.test.mjs b/experiments/osv-download.test.mjs
new file mode 100644
index 0000000..8fd13b5
--- /dev/null
+++ b/experiments/osv-download.test.mjs
@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { createServer } from 'node:http';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import test from 'node:test';
+
+// Run the actual installation block against a bounded local server. The first
+// response ends before Content-Length bytes arrive (curl error 18); retry succeeds.
+test('OSV installation retries a partial transfer and verifies the downloaded checksum', { timeout: 20000 }, async t => {
+  const directory = mkdtempSync(join(tmpdir(), 'osv-download-'));
+  t.after(() => rmSync(directory, { recursive: true, force: true }));
+  const binary = '#!/bin/sh\necho scanner\n';
+  let requests = 0;
+  const server = createServer((request, response) => {
+    requests++;
+    response.setHeader('Content-Length', Buffer.byteLength(binary));
+    response.setHeader('Connection', 'close');
+    response.end(requests === 1 ? binary.slice(0, 5) : binary);
+  });
+  t.after(() => server.close());
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  const workflow = readFileSync(new URL('../.github/workflows/security.yml', import.meta.url), 'utf8');
+  const script = workflow.split('      - name: Install OSV-Scanner\n')[1]
+    .split('        run: |\n')[1].split('\n      - name:')[0]
+    .replace('https://github.com/google/osv-scanner/releases/download/${OSV_SCANNER_VERSION}/osv-scanner_linux_amd64',
+      `http://127.0.0.1:${server.address().port}/scanner`);
+  const child = spawn('bash', ['-c', script], {
+    env: { ...process.env, RUNNER_TEMP: directory, GITHUB_PATH: join(directory, 'path'),
+      OSV_SCANNER_SHA256: createHash('sha256').update(binary).digest('hex') },
+    timeout: 15000,
+  });
+  t.after(() => { if (child.exitCode === null) child.kill(); });
+  let output = '';
+  child.stdout.on('data', data => { output += data; });
+  child.stderr.on('data', data => { output += data; });
+  const code = await new Promise((resolve, reject) => { child.once('error', reject); child.once('close', resolve); });
+  assert.equal(code, 0, output);
+  assert.equal(requests, 2, output);
+  assert.match(output, /curl: \(18\)/);
+  assert.match(output, /: OK/);
+  assert.equal(readFileSync(join(directory, 'osv-scanner', 'osv-scanner'), 'utf8'), binary);
+});
